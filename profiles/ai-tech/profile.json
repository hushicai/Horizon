{
  "id": "ai-tech",
  "name": "AI Engineering / Research",
  "display_names": {
    "zh": "AI 技术与实践"
  },
  "match": "match.md",
  "analysis": "analysis.md",
  "content": {
    "analysis_max_chars": 16000,
    "enrichment_max_chars": 24000,
    "sampling": "head-middle-tail"
  },
  "enrichment": {
    "prompt": "enrichment.md",
    "blocks": [
      {
        "id": "summary",
        "type": "section",
        "tools": [],
        "primary": true
      },
      {
        "id": "method",
        "type": "section",
        "tools": ["web_search"]
      },
      {
        "id": "engineering_takeaway",
        "type": "section",
        "tools": ["history_search", "web_search"]
      },
      {
        "id": "open_questions",
        "type": "section",
        "tools": [],
        "optional": true
      }
    ]
  }
}
